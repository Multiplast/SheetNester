{
    "name": "multiplast/sheet-nester",
    "description": "2D nesting (guillotine bin packing) of rectangular pieces onto stock sheets, with SVG and PDF cutting plans.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["nesting", "bin-packing", "guillotine", "cutting-plan", "sheet"],
    "authors": [
        {
            "name": "TITAN – Multiplast s.r.o.",
            "homepage": "https://www.titan-multiplast.cz"
        }
    ],
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "mpdf/mpdf": "^8.1",
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5 || ^12.0"
    },
    "suggest": {
        "mpdf/mpdf": "Required by SheetNesterPdf to render PDF cutting plans (^8.1)."
    },
    "conflict": {
        "mpdf/mpdf": "<8.0"
    },
    "autoload": {
        "psr-4": {
            "Multiplast\\SheetNester\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Multiplast\\SheetNester\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
